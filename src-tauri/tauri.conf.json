{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Revision TP",
  "version": "1.1.1",
  "identifier": "com.educentre.revision-tp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Révision TP - Préparation aux titres professionnels",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; media-src 'self' blob:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "French"
        ],
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDOTBBMUZGRkY2MDM0RjYKUldUMk5HRC8vNkdRdk5nSlZWZGd3YU5CbzhmYU43bDJLczhROGdacUVwWlFhOCtJRUxiWVIvL1UK",
      "endpoints": [
        "https://github.com/yosniper973-ux/revision-tp/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}